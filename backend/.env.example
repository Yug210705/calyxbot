# ==========================================
# Calyx API - Environment Configuration
# ==========================================

# Application Environment
# Options: development, staging, production
APP_ENV=development

# Logging Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# CORS Origins
# Comma-separated list (or JSON list depending on Pydantic parsing)
# For Pydantic list of strings, JSON formatting or comma separated might be supported depending on how it's passed.
# Pydantic v2 BaseSettings handles JSON encoded lists natively.
CORS_ORIGINS='["http://localhost:3000"]'

# ==========================================
# Supabase Configuration
